// Spell-checker settings (cSpell VS Code extension). Comments are allowed in this file.
{
    "version": "0.2",
    // British and general English
    "language": "en,en-GB",
    // Technical terms, product names and PowerShell/Windows command names
    // that the script uses and the dictionary would otherwise flag
    "words": [
        "ACPI",
        "APOs",
        "Armoury",
        "ASUS",
        "Audiosrv",
        "bennh",
        "DEVPKEY",
        "DRYRUN",
        "FiiO",
        "Genesys",
        "getactivescheme",
        "Hiberboot",
        "HKLM",
        "hotfixes",
        "HTREE",
        "Krisp",
        "LASTEXITCODE",
        "logman",
        "LSPM",
        "Maxx",
        "mutex",
        "Nahimic",
        "NTSTATUS",
        "PKEY",
        "pnputil",
        "powercfg",
        "Prio",
        "pscustomobject",
        "PSES",
        "Realtek",
        "rescan",
        "setactive",
        "setacvalueindex",
        "setdcvalueindex",
        "SMBIOSBIOS",
        "SMSC",
        "Thesycon",
        "UBR",
        "UCX",
        "usbaudio",
        "usbhub",
        "USBXHCI",
        "Voicemeeter",
        "xHCI",
        "XMOS"
    ],
    // Generated output and editor config are not spell-checked
    "ignorePaths": [
        "FiiO-K7-Report-*.txt",
        "FiiO-K7-Backup-*.json",
        "reports/**",
        ".vscode/**"
    ]
}
